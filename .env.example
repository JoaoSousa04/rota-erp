# Exemplo seguro para desenvolvimento local.
# Quando a aplicação Laravel estiver criada, copie este arquivo para .env e preencha os valores locais.
# Nunca coloque a senha real aqui: este arquivo é versionado pelo Git.

APP_NAME="Rota ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rota_erp
DB_USERNAME=rota_erp_user
# Preencha apenas no arquivo .env local. Não compartilhe nem envie ao GitHub.
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
